[Unit]
Description=ShopLite PostgreSQL Automated Backup Service
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Restart=on-failure
RestartSec=30s
EnvironmentFile=-/etc/default/shoplite-backup
ExecStart=/opt/shoplite/scripts/backup-postgres.sh
StandardOutput=journal
StandardError=journal
