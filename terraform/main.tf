# ==============================================================================
# ShopLite: Root Terraform Orchestrator (Question 4: AWS Infrastructure as Code)
# Modules: network, compute (with 10GB EBS data volumes), alb, ecr
# ==============================================================================

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      project     = "shoplite"
      environment = var.environment
      managed_by  = "terraform"
    }
  }
}

data "aws_caller_identity" "current" {}

# 1. Modular VPC & Least-Privilege Security Groups
module "network" {
  source = "./modules/network"

  vpc_cidr             = var.vpc_cidr
  public_subnet_cidrs  = var.public_subnet_cidrs
  private_subnet_cidrs = var.private_subnet_cidrs
  environment          = var.environment
  enable_ssh_bastion   = var.enable_ssh_bastion
  allowed_ssh_cidr     = var.allowed_ssh_cidr
}

# 2. Compute: 1 Control-Plane + 2 Worker EC2 Nodes + 10GB EBS Data Volumes
module "compute" {
  source = "./modules/compute"

  environment                 = var.environment
  private_subnet_ids          = module.network.private_subnet_ids
  public_subnet_ids           = module.network.public_subnet_ids
  nodes_security_group_id     = module.network.nodes_security_group_id
  bastion_security_group_id   = module.network.bastion_security_group_id
  control_plane_instance_type = var.control_plane_instance_type
  worker_instance_type        = var.worker_instance_type
  worker_node_count           = var.worker_node_count
  storage_volume_size_gb      = var.storage_volume_size_gb
  key_name                    = var.key_name
  enable_ssh_bastion          = var.enable_ssh_bastion
}

# 3. Application Load Balancer in Public Subnets
module "alb" {
  source = "./modules/alb"

  environment           = var.environment
  vpc_id                = module.network.vpc_id
  public_subnet_ids     = module.network.public_subnet_ids
  alb_security_group_id = module.network.alb_security_group_id
  worker_ids            = module.compute.worker_ids
}

# 4. Amazon ECR Repositories for all 3 microservices
module "ecr" {
  source = "./modules/ecr"

  environment = var.environment
}

# 5. Cost Guard: AWS Budget Alarm at USD 20
resource "aws_budgets_budget" "cost_guard" {
  name              = "shoplite-monthly-budget-${var.environment}"
  budget_type       = "COST"
  limit_amount      = var.budget_limit_usd
  limit_unit        = "USD"
  time_period_start = "2026-01-01_00:00"
  time_unit         = "MONTHLY"

  notification {
    comparison_operator        = "GREATER_THAN"
    threshold                  = 80
    threshold_type             = "PERCENTAGE"
    notification_type          = "ACTUAL"
    subscriber_email_addresses = [var.alert_email]
  }

  notification {
    comparison_operator        = "GREATER_THAN"
    threshold                  = 100
    threshold_type             = "PERCENTAGE"
    notification_type          = "FORECASTED"
    subscriber_email_addresses = [var.alert_email]
  }
}

# 6. Auto-generate Ansible Inventory (zero manual IP editing after terraform apply)
resource "local_file" "ansible_inventory" {
  count           = var.generate_ansible_inventory ? 1 : 0
  filename        = "${path.module}/../ansible/inventory/hosts.ini"
  file_permission = "0644"

  content = <<-EOT
# Auto-generated by Terraform — do not edit manually
[control_plane]
cp-node-1 ansible_host=${var.enable_ssh_bastion ? module.compute.control_plane_public_ip : module.compute.control_plane_id} private_ip=${module.compute.control_plane_private_ip} node_role=control_plane

[workers]
%{for idx, ip in module.compute.worker_private_ips~}
worker-node-${idx + 1} ansible_host=${var.enable_ssh_bastion ? ip : module.compute.worker_ids[idx]} private_ip=${ip} node_role=worker
%{endfor~}

%{if var.enable_ssh_bastion~}
[workers:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ProxyJump=ubuntu@${module.compute.control_plane_public_ip}'
%{endif~}

[k8s_cluster:children]
control_plane
workers

[k8s_cluster:vars]
%{if var.enable_ssh_bastion~}
ansible_user=ubuntu
ansible_ssh_private_key_file=${var.ssh_private_key_path}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
%{else~}
ansible_connection=amazon.aws.aws_ssm
ansible_user=ssm-user
ansible_aws_ssm_region='${var.aws_region}'
ansible_aws_ssm_bucket_name='${module.compute.ssm_staging_bucket_name}'
%{endif~}
ansible_python_interpreter=/usr/bin/python3
kubernetes_version='1.30'
pod_network_cidr='10.244.0.0/16'
service_cidr='10.96.0.0/12'
aws_region='${var.aws_region}'
aws_account_id='${data.aws_caller_identity.current.account_id}'
ecr_registry='${data.aws_caller_identity.current.account_id}.dkr.ecr.${var.aws_region}.amazonaws.com'
alb_dns_name='${module.alb.alb_dns_name}'
cp_public_ip='${var.enable_ssh_bastion ? module.compute.control_plane_public_ip : module.compute.control_plane_private_ip}'
cp_private_ip='${module.compute.control_plane_private_ip}'
EOT
}
