# ==============================================================================
# ShopLite: Terraform Variables Template for Poridhi Lab
# Region: Singapore (ap-southeast-1)
# Copy this file to terraform.tfvars if overriding defaults
# ==============================================================================

aws_region  = "ap-southeast-1"
environment = "dev"

vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.20.0/24"]

control_plane_instance_type = "t3.medium"
worker_instance_type        = "t3.medium"
worker_node_count           = 2
storage_volume_size_gb      = 10

# Pure SSM (default false) vs Poridhi SSH Bastion fallback (true)
enable_ssh_bastion   = false
allowed_ssh_cidr     = "0.0.0.0/0"
key_name             = "shoplite-key"
ssh_private_key_path = "~/.ssh/shoplite-key.pem"

budget_limit_usd = "20"
alert_email      = "student@example.com"
