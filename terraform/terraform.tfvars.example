# ==============================================================================
# ShopLite: Terraform Variables Template for Poridhi Lab
# Region: Singapore (ap-southeast-1)
# Copy this file to terraform.tfvars before running terraform apply
# ==============================================================================

aws_region  = "ap-southeast-1"
environment = "dev"

# VPC Subnet CIDRs
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.20.0/24"]

# Compute Node Sizing
control_plane_instance_type = "t3.medium"
worker_instance_type        = "t3.medium"
worker_node_count           = 2

# Access Architecture: Pure SSM vs SSH Bastion Fallback
# Set to false for 100% Exam-Compliant Pure SSM in Private Subnets (No Port 22, No Public IP)
# Set to true in Poridhi Lab only if AWS SSM is blocked by sandbox SCP
enable_ssh_bastion = false
key_name           = "shoplite-key"

# Cost Guard
budget_limit_usd = "20"
alert_email      = "student@example.com"

